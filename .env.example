# ai-shell Configuration
# Copy to .env and customize for your environment
# .env is gitignored and never committed

# AWS Bedrock Configuration
BEDROCK_REGION=us-west-2
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here

# Strands Agent (aish.py) Defaults
AISH_MODEL_ID=us.amazon.nova-lite-v1:0
AISH_TEMPERATURE=0.1
AISH_MAX_TOKENS=2048

# YouTube API (optional, for enhanced metadata)
YOUTUBE_API_KEY=your_youtube_api_key_here

# Twitter/X API (optional, for X content extraction)
TWITTER_BEARER_TOKEN=your_x_api_token_here

# Debug Logging (optional)
LOG_LEVEL=WARNING
